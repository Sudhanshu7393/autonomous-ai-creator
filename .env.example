# ─────────────────────────────────────────────────────────────────
#  Autonomous AI Creator — Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# REQUIRED — Groq API key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED — Tavily API key (free at app.tavily.com — 1000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Scheduler ─────────────────────────────────────────────────────
# Demo mode:       60–120 seconds
# Production mode: 7200–10800 seconds (2–3 hours)
CYCLE_INTERVAL_SECONDS=90

# ── Editorial Bar ─────────────────────────────────────────────────
MIN_RELEVANCE_SCORE=6.5
MAX_TOPICS_PER_CYCLE=8

# ── Storage ───────────────────────────────────────────────────────
DB_PATH=./data/agent.db

# ── API ───────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Model (Groq) ──────────────────────────────────────────────────
# Options: llama-3.3-70b-versatile | llama3-70b-8192 | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
